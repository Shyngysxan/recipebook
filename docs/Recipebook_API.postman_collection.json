                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/drf/recipes/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "drf",
                "recipes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function(){ pm.response.to.have.status(200); });",
                  "const j=pm.response.json(); if(j.length){ pm.collectionVariables.set(\"existing_recipe_id\", j[0].id); }"
